@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

:root {
    --purple: #8d6bb2;
    --dark-purple: #594071;
    --lavender: #e9dcf5;
    --light: #fbf9fd;
    --text: #51465b;
    --muted: #81758b;
    --white: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: var(--light);
    color: var(--text);
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1150px, 90%);
    margin: auto;
}

/* NAVEGACIÓN */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(251,249,253,.88);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid #eee5f4;
}

.navbar {
    min-height: 82px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--dark-purple);
}

.logo {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #bda0d8, #80609f);
    color: white;
    font-family: 'Playfair Display', serif;
    font-size: 25px;
}

.brand strong, .brand span {
    display: block;
    letter-spacing: 3px;
}

.brand strong {
    font-size: 16px;
}

.brand span {
    font-size: 10px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 27px;
    font-size: 13px;
    font-weight: 600;
}

.nav-links a:hover {
    color: var(--purple);
}

.menu-toggle {
    display: none;
    border: none;
    background: none;
    color: var(--dark-purple);
    font-size: 27px;
    cursor: pointer;
}

/* PORTADA */

.hero {
    min-height: 610px;
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(ellipse at 80% 20%, #e5d4f3 0%, transparent 45%),
        radial-gradient(ellipse at 15% 90%, #eee4f7 0%, transparent 50%),
        linear-gradient(135deg, #fcfaff, #f1e8f8);
}

.hero-content {
    min-height: 610px;
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    align-items: center;
    gap: 50px;
    padding-top: 45px;
    padding-bottom: 45px;
}

.eyebrow {
    color: var(--purple);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
}

h1, h2, h3 {
    font-family: 'Playfair Display', serif;
    line-height: 1.2;
}

.hero h1 {
    font-size: clamp(42px, 5.5vw, 68px);
    margin: 20px 0;
    color: var(--dark-purple);
}

.hero h1 span {
    color: #a184bf;
    display: block;
}

.hero-text > p {
    max-width: 520px;
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;
    padding: 13px 25px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 700;
    transition: .3s;
}

.btn:hover {
    transform: translateY(-4px);
}

.btn-primary {
    background: var(--purple);
    color: white;
    box-shadow: 0 8px 20px #8d6bb244;
}

.btn-outline {
    border: 1px solid #bda4d2;
    color: var(--dark-purple);
}

.hero-art {
    min-height: 370px;
    display: grid;
    place-items: center;
    position: relative;
}

.flower-circle {
    width: 285px;
    height: 285px;
    border-radius: 50%;
    background: linear-gradient(145deg, #e4d3f2, #bda1d6);
    box-shadow: 0 25px 65px #8c6bab33;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
}

.flower {
    font-size: 110px;
    line-height: 1.1;
}

.flower-circle span {
    font-weight: 700;
    letter-spacing: 5px;
}

.flower-circle small {
    letter-spacing: 4px;
}

.floating-note {
    position: absolute;
    bottom: 25px;
    right: 0;
    padding: 15px 22px;
    border-radius: 30px;
    background: white;
    box-shadow: 0 8px 30px #59407120;
    color: var(--dark-purple);
    font-size: 12px;
}

/* FRASE */

.quote-section {
    text-align: center;
    padding: 42px 20px;
    background: white;
    color: var(--dark-purple);
    font-family: 'Playfair Display', serif;
    font-size: 23px;
}

/* SECCIONES */

.section {
    padding-top: 100px;
    padding-bottom: 100px;
}

.section-heading {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 55px;
}

.section-heading h2 {
    font-size: clamp(30px, 4vw, 43px);
    color: var(--dark-purple);
    margin: 14px 0;
}

.section-heading p {
    color: var(--muted);
    font-size: 14px;
}

.cards-grid, .research-grid, .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 23px;
}

.info-card, .research-card, .resource-card {
    background: white;
    padding: 35px 28px;
    border-radius: 22px;
    border: 1px solid #eee5f4;
    box-shadow: 0 10px 35px #66517d0c;
    transition: .3s;
}

.info-card:hover, .research-card:hover, .resource-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 40px #66517d20;
}

.card-icon {
    font-size: 30px;
    display: block;
    margin-bottom: 18px;
}

.info-card h3, .research-card h3, .resource-card h3 {
    color: var(--dark-purple);
    font-size: 21px;
    margin-bottom: 12px;
}

.info-card p, .research-card p, .resource-card p {
    color: var(--muted);
    font-size: 13px;
}

/* PROPÓSITO */

.purpose-section {
    background:
        radial-gradient(circle at 80% 40%, #e1d0ef, transparent 40%),
        linear-gradient(120deg, #eee5f6, #faf7fc);
    padding: 100px 0;
}

.purpose-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
}

.purpose-text h2 {
    font-size: 43px;
    color: var(--dark-purple);
    margin: 18px 0;
}

.purpose-text p {
    color: var(--muted);
    margin-bottom: 20px;
}

.text-link {
    font-size: 13px;
    font-weight: 700;
    color: var(--purple);
}

.purpose-decoration {
    min-height: 290px;
    background: white;
    border-radius: 35px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-shadow: 0 15px 45px #59407116;
    color: var(--dark-purple);
}

.heart {
    color: #aa83c9;
    font-size: 110px;
    line-height: 1.2;
}

.purpose-decoration p {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
}

/* RECURSOS */

.resources-section {
    padding: 100px 0;
    background: #f5eff9;
}

.resource-card {
    text-align: center;
}

.resource-card span {
    font-size: 38px;
    display: block;
    margin-bottom: 15px;
}

/* MAPA */

.map-layout {
    display: grid;
    grid-template-columns: 310px 1fr;
    gap: 25px;
    background: white;
    border-radius: 25px;
    padding: 20px;
    box-shadow: 0 12px 40px #59407112;
}

.map-information {
    padding: 20px 10px;
